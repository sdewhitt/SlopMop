FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin credentials (required for server routes that write reports)
# Option A: paste full service account JSON as one line
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: provide split fields (private key should keep escaped \n)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of admin emails allowed to access /admin/reports
ADMIN_REPORT_EMAILS=

# Resend email settings used for report notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Secret header value required by POST /api/reports/dispatch
REPORT_DISPATCH_SECRET=

# Server-controlled report email cadence (immediate|daily|weekly)
REPORT_NOTIFICATION_INTERVAL=immediate